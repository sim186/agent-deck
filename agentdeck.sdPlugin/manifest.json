{
  "Name": "Agent Deck",
  "Description": "Drive coding agents (Claude, Codex, OpenCode, Pi) through herdr",
  "Author": "Simone",
  "Version": "0.5.0",
  "PluginUUID": "com.simone.agentdeck",
  "CodePathMac": "bin/agentdeck",
  "CodePathLin": "bin/agentdeck",
  "CodePathWin": "bin/main.js",
  "CodePaths": {
    "aarch64-apple-darwin": "bin/agentdeck",
    "x86_64-apple-darwin": "bin/agentdeck",
    "x86_64-pc-windows-msvc": "bin/main.js"
  },
  "Icon": "icons/plugin",
  "Category": "Agent Deck",
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "11.0"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.simone.agentdeck.status",
      "Name": "Agent Status",
      "Icon": "icons/status",
      "Tooltip": "Shows working / approve / idle for one agent kind. Press to focus it.",
      "States": [
        {
          "Image": "icons/status"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.approve",
      "Name": "Approve",
      "Icon": "icons/approve",
      "Tooltip": "Lights up when an agent waits for permission. Press to approve (Enter).",
      "States": [
        {
          "Image": "icons/approve"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.keys",
      "Name": "Send Keys",
      "Icon": "icons/tile",
      "Tooltip": "Send key presses to the focused agent",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.prompt",
      "Name": "Prompt",
      "Icon": "icons/tile",
      "Tooltip": "Type a prompt into the focused agent",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.launch",
      "Name": "Launch Agent",
      "Icon": "icons/tile",
      "Tooltip": "Start an agent in a new pane next to the focused one",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.project",
      "Name": "Project",
      "Icon": "icons/tile",
      "Tooltip": "Open a project workspace in herdr",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.editor",
      "Name": "VS Code",
      "Icon": "icons/tile",
      "Tooltip": "Open VS Code on a project (or the focused herdr pane folder)",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.run",
      "Name": "Run Command",
      "Icon": "icons/tile",
      "Tooltip": "Run a shell command in a helper pane in the focused project",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.dictate",
      "Name": "Dictate",
      "Icon": "icons/tile",
      "Tooltip": "Toggle Handy dictation (text goes to the focused window)",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.meeting",
      "Name": "Meeting",
      "Icon": "icons/tile",
      "Tooltip": "Record a meeting, transcribe it with Handy, summarize it with an agent",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.teams",
      "Name": "Teams Share",
      "Icon": "icons/tile",
      "Tooltip": "Open Teams Share content, then choose a single window",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.switch",
      "Name": "Switch Profile",
      "Icon": "icons/tile",
      "Tooltip": "Switch to an Agent Deck profile",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.headless",
      "Name": "Headless Prompt",
      "Icon": "icons/tile",
      "Tooltip": "Run a prompt through pi or opencode in the background and open the answer",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.clock",
      "Name": "Next Meeting",
      "Icon": "icons/tile",
      "Tooltip": "Current time and countdown to the next Outlook meeting",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.agentlist",
      "Name": "Agent Tile",
      "Icon": "icons/status",
      "Tooltip": "One running herdr agent: project and state. Press to focus it.",
      "States": [
        {
          "Image": "icons/status"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.limit",
      "Name": "Usage Limit",
      "Icon": "icons/tile",
      "Tooltip": "Remaining share of a provider limit window (Claude, Codex, OpenCode Go); press to refresh",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.agenda",
      "Name": "Agenda",
      "Icon": "icons/tile",
      "Tooltip": "An upcoming Outlook meeting; press to have the agent brief you on it",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    },
    {
      "UUID": "com.simone.agentdeck.audio",
      "Name": "Audio",
      "Icon": "icons/tile",
      "Tooltip": "Speaker volume up/down, or mute/unmute the microphone",
      "States": [
        {
          "Image": "icons/tile"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false
    }
  ]
}
